# Deploy settings of one repository for "dev-kit deploy". Keep the real file on the host, outside of
# git, at ~/.config/dev-kit/<repository>/etc/deploy.env (mode 600); the devcontainer mounts that
# folder read-only at /etc/dev-kit. KEY=VALUE lines, read as data (nothing here runs).

# Webhook of the repository's Dockhand git stack (stack settings: enable the webhook, set a secret)
DEPLOY_WEBHOOK_URL=https://dockhand.example.com/api/git/stacks/1/webhook

# The webhook secret; dev-kit signs the request with it (HMAC-SHA256) and never sends it
DEPLOY_WEBHOOK_SECRET=replace-with-the-secret-of-the-stack

# Optional: where the app reports its version; dev-kit waits until it reports the new one
DEPLOY_HEALTH_URL=https://myapp.example.com/healthz

# Optional: seconds to wait for the deploy and for the health check (default 600). If a proxy gives
# up waiting for the webhook first (504, Cloudflare's 524), dev-kit waits for the health URL instead
DEPLOY_TIMEOUT=600

# Optional: send the webhook and health calls to this address, keeping the URL (and so the TLS
# certificate check) as it is: host:port:address, several separated by commas. For a name that
# resolves to a CDN (Cloudflare gives up after 100 seconds) while Dockhand is also reachable
# directly in your network
#DEPLOY_RESOLVE=dockhand.example.com:443:192.0.2.10
