# Development commands of myapp (see AGENTS.md, "Development"). AGENTS.md, skills and scripts call
# these recipes, not the tools.

set positional-arguments

# List the recipes
default:
    @just --list

# Type check, lint, tests
check:
    npm run check
    npm run lint
    npm test

# Format everything
fmt:
    npm run format

# Dev server with hot reload on port 5173
serve:
    npm run dev -- --host 0.0.0.0 --port 5173 --strictPort

# The demo: the image with the sample data, at http://127.0.0.1:8080
demo:
    docker compose up --build

# Prepare a release (changelog, version, commit, tag); push it with: dev-kit release --push
release version summary:
    dev-kit release "$1" -m "$2"

# Deploy the release on origin/main and wait for it
deploy:
    dev-kit deploy
