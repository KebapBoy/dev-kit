// Devcontainer: stage "dev" of the Dockerfile, the dev-kit feature (Claude Code with the shared
// configuration, git, just, dev-kit) and Docker inside (docker-in-docker) for just demo.
// .devcontainer/serve.sh runs the dev server with hot reload on port 5173.
{
    "name": "myapp",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": "..",
        "target": "dev"
    },
    // Runs on the host before the container starts: copies your ~/.claude/CLAUDE.md (or an empty
    // file) to ~/.config/dev-kit/, outside of the workspace, which the container can write, and
    // creates the directories with the managed Claude Code settings and this repository's deploy
    // settings if they are missing, so the mounts below work for everyone
    "initializeCommand": "mkdir -p ~/.config/dev-kit/claude-code ~/.config/dev-kit/myapp && { cp ~/.claude/CLAUDE.md ~/.config/dev-kit/CLAUDE.md 2>/dev/null || : > ~/.config/dev-kit/CLAUDE.md; }",
    // root so docker-in-docker can start dockerd; VS Code, its terminals and Claude Code run as dev
    "containerUser": "root",
    "remoteUser": "dev",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": false },
        "ghcr.io/kebapboy/dev-kit/dev-kit:1": {}
    },
    // .devcontainer read-only, so code in the container cannot change what the host runs
    // (initializeCommand) or how it starts the container
    "mounts": [
        "source=${localWorkspaceFolder}/.devcontainer,target=${containerWorkspaceFolder}/.devcontainer,type=bind,readonly",
        "source=${localEnv:HOME}/.config/dev-kit/CLAUDE.md,target=/var/lib/dev-kit/claude/CLAUDE.md,type=bind,readonly",
        "source=${localEnv:HOME}/.config/dev-kit/claude-code,target=/etc/claude-code,type=bind,readonly",
        "source=${localEnv:HOME}/.config/dev-kit/myapp,target=/etc/dev-kit,type=bind,readonly"
    ],
    "forwardPorts": [5173],
    "portsAttributes": {
        "5173": { "label": "myapp (dev server)" },
        "8080": { "label": "myapp (demo)", "onAutoForward": "silent" }
    },
    "postCreateCommand": "{ test -f .env || cp .env.example .env; } && npm ci",
    // VS Code runs this in a terminal that hangs up when the command returns: the dev server
    // ignores that (trap) and leaves the terminal's session (setsid)
    "postStartCommand": "trap '' HUP; setsid .devcontainer/serve.sh > /tmp/serve.log 2>&1 &",
    "customizations": {
        "vscode": {
            "extensions": [
                "svelte.svelte-vscode",
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint",
                "editorconfig.editorconfig"
            ]
        }
    }
}
