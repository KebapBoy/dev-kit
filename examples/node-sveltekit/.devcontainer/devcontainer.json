// Devcontainer: stage "dev" of the Dockerfile, the dev-kit feature (Claude Code with the shared
// configuration, git, just, dev-kit) with Docker inside for just demo. Docker needs the runtime
// sysbox-runc (Sysbox on the host): it keeps the container unprivileged.
// .devcontainer/serve.sh runs the dev server with hot reload on port 5173.
//
// The host does not use this file or the Dockerfile from the repository: copy both to
// ~/.config/dev-kit/myapp/.devcontainer/ and open ~/.config/dev-kit/myapp in VS Code ("Reopen in
// Container"). The code lives in the Docker volume myapp-workspace, never on the host, and code in
// the container cannot change how the host builds and starts it. Take changes to the two files over
// by hand, after reading them (dev-kit-host diff myapp shows them).
{
    "name": "myapp",
    // Runs on the host before the container starts (dev-kit-host from the dev-kit repository):
    // copies your ~/.claude/CLAUDE.md to ~/.config/dev-kit/, clones the repository into the volume
    // myapp-workspace the first time, and warns if this file or the Dockerfile differs from the
    // repository's
    "initializeCommand": "~/.config/dev-kit/bin/dev-kit-host prepare myapp git@github.com:example/myapp.git",
    // The host's copy of the Dockerfile next to this file; the stage dev needs nothing else
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".",
        "target": "dev"
    },
    "workspaceMount": "source=myapp-workspace,target=/workspaces/myapp,type=volume",
    "workspaceFolder": "/workspaces/myapp",
    "remoteUser": "dev",
    "runArgs": ["--runtime=sysbox-runc"],
    "features": {
        "ghcr.io/kebapboy/dev-kit/dev-kit:1": { "docker": true }
    },
    // From the host, read-only: your CLAUDE.md, the managed Claude Code settings and this
    // repository's folder etc next to .devcontainer (deploy settings, deploy key, host keys)
    "mounts": [
        "source=${localEnv:HOME}/.config/dev-kit/CLAUDE.md,target=/var/lib/dev-kit/claude/CLAUDE.md,type=bind,readonly",
        "source=${localEnv:HOME}/.config/dev-kit/claude-code,target=/etc/claude-code,type=bind,readonly",
        "source=${localWorkspaceFolder}/etc,target=/etc/dev-kit,type=bind,readonly"
    ],
    // git fetches with the repository's read-only deploy key from etc (dev-kit-host prepare
    // creates it); the forwarded SSH agent should hold only your signing key, so the container
    // signs commits but cannot push: push from the host with dev-kit-host push
    "remoteEnv": {
        "GIT_SSH_COMMAND": "ssh -i /etc/dev-kit/deploy-key -o IdentitiesOnly=yes -o UserKnownHostsFile=/etc/dev-kit/known_hosts -o StrictHostKeyChecking=yes"
    },
    "forwardPorts": [5173],
    "portsAttributes": {
        "5173": { "label": "myapp (dev server)" },
        "8080": { "label": "myapp (demo)", "onAutoForward": "silent" }
    },
    "postCreateCommand": "{ test -f .env || cp .env.example .env; } && npm ci",
    // VS Code runs this in a terminal that hangs up when the command returns: the dev server
    // ignores that (trap) and leaves the terminal's session (setsid)
    "postStartCommand": "trap '' HUP; setsid .devcontainer/serve.sh > /tmp/serve.log 2>&1 &",
    "customizations": {
        "vscode": {
            "extensions": [
                "svelte.svelte-vscode",
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint",
                "editorconfig.editorconfig"
            ]
        }
    }
}
