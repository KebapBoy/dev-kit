// Run and Debug (F5) in the devcontainer: the app from the working tree at http://localhost:8000,
// started through its entry point with debugpy. Settings come from .env; the rest is what just serve
// sets.
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "myapp (working tree)",
            "type": "debugpy",
            "request": "launch",
            "python": "/home/dev/.venv/bin/python",
            "program": "/home/dev/.venv/bin/myapp",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "MYAPP_HOST": "0.0.0.0",
                "MYAPP_PORT": "8000",
                "MYAPP_DATA_DIR": "/tmp/myapp-dev"
            },
            "console": "integratedTerminal",
            "preLaunchTask": "install"
        }
    ]
}
