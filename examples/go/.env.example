# Settings of myapp, with example values. For development, postCreateCommand copies this file to
# .env (just reads it); for an installation, set them in the environment of the stack
# (deploy/compose.yaml).

# Public URL of the app
MYAPP_BASE_URL=http://localhost:8000

# Secret for signed cookies; generate one with: openssl rand -base64 32
MYAPP_SECRET=

# Time zone
TZ=Europe/Berlin

# deploy/compose.yaml only: the Docker network of the reverse proxy
MYAPP_PROXY_NETWORK=proxy
